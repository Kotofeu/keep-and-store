{
  "name": "keep-and-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 4000 --experimental-https",
    "build": "run-s check build:actual",
    "build:actual": "next build",
    "start": "next start -p 5000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "style": "stylelint \"**/*.{css,scss,sass}\"",
    "style:fix": "stylelint \"**/*.{css,scss,sass}\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "run-p lint style format",
    "fix": "run-p lint:fix style:fix format:fix"
  },
  "dependencies": {
    "next": "15.5.2",
    "next-intl": "^4.3.5",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.2",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "sass": "^1.91.0",
    "stylelint": "^16.23.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "^5",
    "typescript-eslint": "^8.42.0"
  }
